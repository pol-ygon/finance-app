# Copia questo file in .env.local e compila i valori (NON committare .env.local).

# Postgres (Prisma Postgres, regione Francoforte). Usa sslmode=verify-full.
DATABASE_URL=

# Consulente AI (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Facoltativo: modello Gemini da usare
# GEMINI_MODEL=gemini-3.8-flash

# Su Vercel (HTTPS): cookie di sessione "Secure"
# SECURE_COOKIES=1
